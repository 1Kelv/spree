rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function householdExists(householdId) {
      return exists(
        /databases/$(database)/documents/households/$(householdId)
      );
    }

    function member(householdId) {
      return signedIn()
        && householdExists(householdId)
        && request.auth.uid in get(
          /databases/$(database)/documents/households/$(householdId)
        ).data.members;
    }

    function validCategory(category) {
      return category in [
        'Fruit & Veg',
        'Meat & Fish',
        'Bakery',
        'Chilled',
        'Frozen',
        'Food Cupboard',
        'Snacks',
        'Drinks',
        'Baby',
        'Household',
        'Health & Beauty',
        'Other'
      ];
    }

    function validItem(data) {
      return data.keys().hasAll([
          'name',
          'detail',
          'category',
          'quantity',
          'completed',
          'createdBy',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'name',
          'detail',
          'category',
          'quantity',
          'completed',
          'createdBy',
          'createdByAlias',
          'createdAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.detail is string
        && data.detail.size() <= 120
        && validCategory(data.category)
        && data.quantity is int
        && data.quantity >= 1
        && data.quantity <= 999
        && data.completed is bool
        && data.createdBy is string
        && (
          !('createdByAlias' in data)
          || (
            data.createdByAlias is string
            && data.createdByAlias.size() > 0
            && data.createdByAlias.size() <= 40
          )
        )
        && data.createdAt is timestamp;
    }

    function validEditedItem(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.detail is string
        && data.detail.size() <= 120
        && validCategory(data.category)
        && data.quantity is int
        && data.quantity >= 1
        && data.quantity <= 999
        && data.completed is bool;
    }

    match /profiles/{userId} {
      allow get: if signedIn()
        && request.auth.uid == userId;

      allow list, delete: if false;

      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'householdId',
          'alias'
        ])
        && request.resource.data.keys().hasAll([
          'householdId'
        ])
        && request.resource.data.householdId is string
        && (
          !('alias' in request.resource.data)
          || (
            request.resource.data.alias is string
            && request.resource.data.alias.size() > 0
            && request.resource.data.alias.size() <= 40
          )
        )
        && request.auth.uid in getAfter(
          /databases/$(database)/documents/households/$(request.resource.data.householdId)
        ).data.members;
    }

    match /households/{householdId} {
      allow get: if signedIn();

      allow list, delete: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'name',
          'ownerId',
          'members',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name',
          'ownerId',
          'members',
          'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members == [
          request.auth.uid
        ]
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn()
        && request.auth.uid != resource.data.ownerId
        && !(request.auth.uid in resource.data.members)
        && resource.data.members.size() < 20
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(['members'])
        && request.resource.data.members is list
        && request.resource.data.members.size()
          == resource.data.members.size() + 1
        && request.resource.data.members.hasAll(
          resource.data.members
        )
        && request.auth.uid
          in request.resource.data.members;

      match /items/{itemId} {
        allow get, list: if member(householdId);

        allow create: if member(householdId)
          && validItem(request.resource.data)
          && request.resource.data.createdBy
            == request.auth.uid
          && request.resource.data.createdAt
            == request.time;

        allow update: if member(householdId)
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'name',
              'detail',
              'category',
              'quantity',
              'completed'
            ])
          && validEditedItem(
            request.resource.data
          );

        allow delete: if member(householdId);
      }
    }
  }
}